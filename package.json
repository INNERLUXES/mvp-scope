{
  "name": "mvp-scope",
  "version": "1.0.0",
  "description": "Cut a startup's feature list into a first release that proves the idea and the releases after it: core features and everything they need, checked against a limit in weeks, then the rest by value per day. Reads a CSV, fetches nothing, no dependencies.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "mvp-scope": "bin/mvp-scope.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.js\"",
    "check": "node tools/check.mjs",
    "example": "node bin/mvp-scope.js --features examples/features.csv --people 2"
  },
  "keywords": [
    "mvp",
    "release-planning",
    "scope",
    "roadmap",
    "startup",
    "product-development",
    "dependencies",
    "cli"
  ],
  "author": "INNERLUXES <info@innerluxes.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INNERLUXES/mvp-scope.git"
  },
  "homepage": "https://innerluxes.dev/software-development/startup"
}
